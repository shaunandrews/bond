#!/bin/sh
# Tracked pre-commit hook. Enabled via `git config core.hooksPath .githooks`,
# which the "prepare" npm script wires up automatically on `npm install`.
set -e
root="$(git rev-parse --show-toplevel)"
npm run design-system:check --prefix "$root"
npm run typecheck --prefix "$root"
npm run test:run --prefix "$root"
